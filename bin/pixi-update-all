#!/usr/bin/env -S pixi run -q --experimental --script
# /// conda-script
# channels = ["https://prefix.dev/conda-forge"]
# entrypoint = "python ${SCRIPT}"
#
# [dependencies]
# python = ">=3.10"
# rich = ">=13"
# /// end-conda-script
"""Run `pixi update` next to every pixi.toml under a root (default: CWD).

Usage: pixi update-all [lock] [ROOT]

`lock` runs `pixi lock` instead. It is a positional verb rather than a flag
because `pixi run --script` consumes any leading `--flag` before this script
sees it.
"""

import asyncio
import os
import sys
from pathlib import Path

from rich.console import Console
from rich.panel import Panel
from rich.progress import BarColumn, MofNCompleteColumn, Progress, TextColumn, TimeElapsedColumn

console = Console()

# Running under `pixi run --script` exports these pointing at this script's own
# environment; a child pixi would resolve against them instead of its workspace.
INHERITED_FROM_SCRIPT_ENV = (
    "PIXI_PROJECT_ROOT",
    "PIXI_PROJECT_NAME",
    "PIXI_PROJECT_MANIFEST",
    "PIXI_PROJECT_VERSION",
    "PIXI_PROMPT",
    "PIXI_ENVIRONMENT_NAME",
    "PIXI_ENVIRONMENT_PLATFORMS",
    "CONDA_PREFIX",
    "CONDA_DEFAULT_ENV",
    "INIT_CWD",
)
CHILD_ENV = {k: v for k, v in os.environ.items() if k not in INHERITED_FROM_SCRIPT_ENV}


async def run(directory: Path, command: str) -> tuple[Path, int, str]:
    proc = await asyncio.create_subprocess_exec(
        "pixi",
        command,
        cwd=directory,
        env=CHILD_ENV,
        stdout=asyncio.subprocess.DEVNULL,
        stderr=asyncio.subprocess.PIPE,
    )
    _, err = await proc.communicate()
    return directory, proc.returncode, err.decode().strip()


# ponytail: unbounded fan-out, add a Semaphore if you have hundreds of manifests
async def main() -> int:
    args = sys.argv[1:]
    command = "lock" if "lock" in args else "update"
    roots = [a for a in args if a != "lock"]
    root = Path(roots[0] if roots else Path.cwd()).expanduser().resolve()

    manifests = [p for p in root.rglob("pixi.toml") if ".pixi" not in p.parts]
    if not manifests:
        console.print(f"[bright_green]No pixi.toml found under[/] [bright_cyan]{root}")
        return 0

    def label(directory: Path) -> str:
        try:
            return str(directory.relative_to(root)) or "."
        except ValueError:
            return str(directory)

    console.print(
        f"[bold bright_cyan]pixi {command}[/] in [bold]{len(manifests)}[/] workspace(s) "
        f"under [bright_cyan]{root}[/]\n"
    )

    failed = []
    with Progress(
        TextColumn(f"[bright_cyan]{command}"),
        BarColumn(complete_style="bright_cyan", finished_style="bright_green"),
        MofNCompleteColumn(),
        TimeElapsedColumn(),
        console=console,
    ) as progress:
        task = progress.add_task(command, total=len(manifests))
        pending = [run(m.parent, command) for m in manifests]
        for coro in asyncio.as_completed(pending):
            directory, code, err = await coro
            if code == 0:
                progress.console.print(f"[bright_green]✓[/] {label(directory)}")
            else:
                failed.append((directory, err))
                progress.console.print(f"[bright_red]✗[/] [bold]{label(directory)}")
            progress.advance(task)

    ok = len(manifests) - len(failed)
    summary = f"[bold bright_green]{ok} ok[/]"
    if failed:
        summary += f", [bold bright_red]{len(failed)} failed[/]"
    console.print(f"\n{summary}")

    for directory, err in failed:
        console.print(
            Panel(
                err or "[dim]no stderr output",
                title=f"[bright_red]{label(directory)}",
                border_style="bright_red",
                title_align="left",
            )
        )

    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(asyncio.run(main()))
    except KeyboardInterrupt:
        sys.exit(130)
