// ─────────────────────────────────────────────────────────────────────────────
// 90 — Your personal overrides
// ─────────────────────────────────────────────────────────────────────────────
//
// This file is YOURS. iNiR updates will never overwrite it.
// Put any custom configuration here: extra binds, per-app window rules,
// output configuration, named workspaces, etc.
//
// Since Niri evaluates config top-to-bottom, settings here take effect
// after all other config.d files. For window-rule properties, all matching
// rules accumulate. For scalar values (like gaps), the last one wins.
//
// Examples:
//
//   // Named workspaces (sticky, always present)
//   workspace "browser"
//   workspace "code"
//   workspace "music"
//
//   // Per-app workspace assignment
//   window-rule {
//       match app-id="firefox"
//       open-on-workspace "browser"
//   }
//
//   // Extra keybind
//   binds {
//       Mod+P { spawn "rofi" "-show" "drun"; }
//   }
//
//   // Output config for your specific monitor
//   output "DP-1" {
//       mode "3440x1440@100.000"
//       scale 1
//       position x=0 y=0
//   }
// ─────────────────────────────────────────────────────────────────────────────

window-rule {
    match is-focused=true
    opacity 0.94
}

window-rule {
    match is-focused=false
    opacity 0.85
}

window-rule {
    match app-id="spotify"
    draw-border-with-background false
    opacity 0.93
}

window-rule {
    match app-id="dev.zed.*"
    opacity 0.85
}

window-rule {
    match app-id="kitty" is-active=true
    opacity 0.90
}

window-rule {
    match app-id="kitty" is-focused=false
    opacity 0.80
}

window-rule {
    match app-id="org.wezfurlong.wezterm" is-active=true
    opacity 0.90
}

window-rule {
    match app-id="org.wezfurlong.wezterm" is-focused=false
    opacity 0.80
}

input {
    focus-follows-mouse max-scroll-amount="0%"
}

output "HDMI-A-3" {
    mode "1920x1080@74.973"
    scale 1
    position x=1920 y=0
    transform "90"
}

binds {
    Mod+G hotkey-overlay-title="Toggle Gaming Mode (Kanata)" { spawn "/home/tenzin/bin/kanata-toggle-gaming.sh"; }

    Mod+Space repeat=false { spawn "/home/tenzin/.local/bin/inir" "overview" "toggle"; }
    Mod+V { spawn "/home/tenzin/.local/bin/inir" "clipboard" "toggle"; }
    Mod+Alt+L allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "lock" "activate"; }
    Mod+Alt+Shift+L allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "lock" "focus"; }

    Mod+Shift+S { spawn "/home/tenzin/.local/bin/inir" "region" "screenshot"; }
    Mod+Shift+X { spawn "/home/tenzin/.local/bin/inir" "region" "ocr"; }
    Mod+Shift+A { spawn "/home/tenzin/.local/bin/inir" "region" "search"; }
    Ctrl+Shift+S { spawn "/home/tenzin/.local/bin/inir" "region" "menu"; }

    Ctrl+Alt+T { spawn "/home/tenzin/.local/bin/inir" "wallpaperSelector" "toggle"; }
    Mod+Comma { spawn "/home/tenzin/.local/bin/inir" "settings"; }
    Mod+Slash { spawn "/home/tenzin/.local/bin/inir" "cheatsheet" "toggle"; }
    Mod+Shift+W { spawn "/home/tenzin/.local/bin/inir" "panelFamily" "cycle"; }

    Mod+Shift+Q { spawn "/home/tenzin/.local/bin/inir" "session" "toggle"; }

    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Super+B hotkey-overlay-title="Open browser" { spawn "zen-browser"; }
    Super+W hotkey-overlay-title="Open browser" { spawn "zen-browser"; }

    Mod+Q repeat=false { spawn "/home/tenzin/.local/bin/inir" "close-window"; }

    Mod+Return { maximize-column; }
    Mod+O repeat=false hotkey-overlay-title="Toggle Window Opacity" { toggle-window-rule-opacity; }

    Mod+Shift+R { spawn "/home/tenzin/.local/bin/inir" "region" "recordWithSound"; }

    Mod+Left  { spawn "/home/tenzin/bin/niri-smart-move.sh" "left" "focus"; }
    Mod+Right { spawn "/home/tenzin/bin/niri-smart-move.sh" "right" "focus"; }
    Mod+H     { spawn "/home/tenzin/bin/niri-smart-move.sh" "left" "focus"; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { spawn "/home/tenzin/bin/niri-smart-move.sh" "right" "focus"; }
    Mod+Semicolon { focus-window-previous; }

    Mod+Shift+Left  { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Up    { set-window-height "+10%"; }
    Mod+Shift+Down  { set-window-height "-10%"; }
    Mod+Shift+H     { spawn "/home/tenzin/bin/niri-smart-move.sh" "left" "move"; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+L     { spawn "/home/tenzin/bin/niri-smart-move.sh" "right" "move"; }

    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }

    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "audio" "volumeUp"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "audio" "volumeDown"; }
    XF86AudioMute        allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "audio" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "audio" "micMute"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "brightness" "increment"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/tenzin/.local/bin/inir" "brightness" "decrement"; }

    XF86AudioPlay  { spawn "/home/tenzin/.local/bin/inir" "mpris" "playPause"; }
    XF86AudioPause { spawn "/home/tenzin/.local/bin/inir" "mpris" "playPause"; }
    XF86AudioNext  { spawn "/home/tenzin/.local/bin/inir" "mpris" "next"; }
    XF86AudioPrev  { spawn "/home/tenzin/.local/bin/inir" "mpris" "previous"; }

    Ctrl+Mod+Space { spawn "/home/tenzin/.local/bin/inir" "mpris" "playPause"; }
    Mod+Alt+N      { spawn "/home/tenzin/.local/bin/inir" "mpris" "next"; }
    Mod+Alt+P      { spawn "/home/tenzin/.local/bin/inir" "mpris" "previous"; }
    Mod+Shift+M    { spawn "/home/tenzin/.local/bin/inir" "audio" "mute"; }
    Mod+Shift+P    { spawn "/home/tenzin/.local/bin/inir" "mpris" "playPause"; }
    Mod+Shift+N    { spawn "/home/tenzin/.local/bin/inir" "mpris" "next"; }
    Mod+Shift+B    { spawn "/home/tenzin/.local/bin/inir" "mpris" "previous"; }
}
