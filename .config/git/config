[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[push]
  autoSetupRemote = true
	default = current

[merge]
  tool = codediff

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "diffview"]
  cmd = nvim -n -c "DiffviewOpen" "$MERGE"

[init]
  defaultBranch = main

[user]
  name = tenzinplatter
  email = 143778894+TenzinPlatter@users.noreply.github.com

[includeIf "hasconfig:remote.*.url:git@github.sydney.edu.au:*/**"]
  path = config-usyd

[includeIf "hasconfig:remote.*.url:https://github.sydney.edu.au/**"]
  path = config-usyd

[includeIf "hasconfig:remote.*.url:syd:*"]
  path = config-usyd

[includeIf "hasconfig:remote.*.url:syd:*/**"]
  path = config-usyd

[core]
  compression = 9
  whitespace = error
  preloadindex = true
  excludesFile = /home/tenzin/.gitignore_global
  pager = delta

[delta]
  side-by-side = true
  line-numbers = true
  line-numbers-left-format  = "{nm:>1}│"
  line-numbers-right-format = "{np:>1}│"

[url "git@github.com:tenzinplatter/"]
  insteadOf = "tp:"

[url "git@github.sydney.edu.au:tpla0149/"]
  insteadOf = "syd:"

[url "git@github.com:greenroom-robotics/"]
  insteadOf = "gr:"

[url "git@github.com:"]
  insteadOf = "gh:"

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[diff-so-fancy]
  markEmptyLines = false

[color "diff"]
  meta = black bold
  frag = magenta
  context = white
  whtiespace = yellow reverse
  old = red

[mergetool "codediff"]
  cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
