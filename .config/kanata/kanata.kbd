(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 150
  hold-time 200
  ;; urob's require-prior-idle-ms: if the previous key was pressed this
  ;; recently, we're mid-burst, so the mod is a plain letter, no hold at all.
  prior-idle 150
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /))

(defalias
  ;; Caps lock → Esc (tap) / Ctrl (hold)
  cec (tap-hold $tap-time $hold-time esc lctl)

  ;; Home row mods - opposite-hand chordal hold (GACS: Super, Alt, Ctrl, Shift)
  ;; A mod resolves to its modifier only when the next key is on the OTHER
  ;; hand (see defhands), so same-hand rolls never misfire. spc/tab are
  ;; neutral, so resting on a mod while reaching for them just types the letter.
  ;; same-hand ignore + timeout hold: a quick same-hand roll still taps (released
  ;; before timeout), but HOLDING two same-hand mods past the timeout chords them
  ;; (e.g. d+f = Ctrl+Shift).
  a- (tap-hold-opposite-hand $hold-time a lmet (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  s- (tap-hold-opposite-hand $hold-time s lalt (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  d- (tap-hold-opposite-hand $hold-time d lctl (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  f- (tap-hold-opposite-hand $hold-time f lsft (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  j- (tap-hold-opposite-hand $hold-time j rsft (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  k- (tap-hold-opposite-hand $hold-time k rctl (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  l- (tap-hold-opposite-hand $hold-time l ralt (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))
  ;- (tap-hold-opposite-hand $hold-time ; rmet (neutral-keys spc tab) (neutral hold) (same-hand ignore) (timeout hold))

  ;; prior-idle gate: plain letter mid-burst, hold-tap when starting from rest.
  a (switch ((key-timing 1 less-than $prior-idle)) a break () @a- break)
  s (switch ((key-timing 1 less-than $prior-idle)) s break () @s- break)
  d (switch ((key-timing 1 less-than $prior-idle)) d break () @d- break)
  f (switch ((key-timing 1 less-than $prior-idle)) f break () @f- break)
  j (switch ((key-timing 1 less-than $prior-idle)) j break () @j- break)
  k (switch ((key-timing 1 less-than $prior-idle)) k break () @k- break)
  l (switch ((key-timing 1 less-than $prior-idle)) l break () @l- break)
  ; (switch ((key-timing 1 less-than $prior-idle)) ; break () @;- break)
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cec @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer gaming
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cec a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)
