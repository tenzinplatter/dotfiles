(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 150
  hold-time 200
  ;; Mirrors config/skeletyl.keymap hml/hmr:
  ;;   tapping-term-ms 280, require-prior-idle-ms 150
  hrm-hold-time 280
  prior-idle 150
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /))

(defalias
  ;; Caps lock → Esc (tap) / Ctrl (hold)
  cec (tap-hold $tap-time $hold-time esc lctl)

  ;; Home row mods (GACS: Super, Alt, Ctrl, Shift), mirroring the hml/hmr
  ;; hold-tap behaviors in ~/zmk-skeletyl/config/skeletyl.keymap:
  ;;   -release variant      = hold-trigger-on-release
  ;;   opposite-hand + thumbs = hold-trigger-key-positions <KEYS_x THUMBS>
  ;;   (require-prior-idle N) = require-prior-idle-ms
  ;;   (same-hand ignore)     = same-hand key is NOT in the trigger list
  ;;   (timeout hold)         = flavor "balanced" falling back to hold
  ;; unknown-hand covers keys the Skeletyl doesn't have (digits, F-keys,
  ;; arrows); hold so Super+1, Ctrl+Left etc. still work.
  a (tap-hold-opposite-hand-release $hrm-hold-time a lmet (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  s (tap-hold-opposite-hand-release $hrm-hold-time s lalt (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  d (tap-hold-opposite-hand-release $hrm-hold-time d lctl (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  f (tap-hold-opposite-hand-release $hrm-hold-time f lsft (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  j (tap-hold-opposite-hand-release $hrm-hold-time j rsft (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  k (tap-hold-opposite-hand-release $hrm-hold-time k rctl (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  l (tap-hold-opposite-hand-release $hrm-hold-time l ralt (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
  ; (tap-hold-opposite-hand-release $hrm-hold-time ; rmet (neutral-keys spc tab ret bspc esc) (neutral hold) (same-hand ignore) (unknown-hand hold) (timeout hold) (require-prior-idle $prior-idle))
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cec @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer gaming
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cec a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)
